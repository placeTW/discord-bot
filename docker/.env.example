# ============================================================
# Discord Bot — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================


# ------------------------------------------------------------
# Discord tokens
# ------------------------------------------------------------

# Production bot token (used when starting with: python main.py prod)
DISCORD_TOKEN=

# Development bot token (used when starting with: python main.py)
DISCORD_TOKEN_DEV=

# Discord server (guild) ID for the PlaceTW server
PLACETW_SERVER_ID=

# Channel ID where the bot sends internal logs
LOG_CHANNEL=


# ------------------------------------------------------------
# Database
#
# Set DATABASE_URL to point to any PostgreSQL instance.
#
# If using the bundled postgres service in docker-compose.yml,
# the hostname is the service name "postgres":
#   DATABASE_URL=postgresql://botuser:yourpassword@postgres:5432/discord_bot
#
# For an external PostgreSQL instance, use its host/IP instead:
#   DATABASE_URL=postgresql://user:password@your-host:5432/your-db
# ------------------------------------------------------------

DATABASE_URL=postgresql://botuser:yourpassword@postgres:5432/discord_bot

# Alternative: set individual connection vars instead of DATABASE_URL.
# DATABASE_URL takes precedence if both are set.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=discord_bot
# POSTGRES_USER=botuser
# POSTGRES_PASSWORD=yourpassword

# Required when using the bundled postgres Docker service (read by docker-compose.yml).
# Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=yourpassword


# ------------------------------------------------------------
# External APIs (optional — commands will fail gracefully if unset)
# ------------------------------------------------------------

# https://thecatapi.com — used by /cat
CAT_API_KEY=

# https://moderatecontent.com — used for confession image moderation
MODERATE_CONTENT_API_KEY=

# YouTube Data API v3 — used by /capoo
YOUTUBE_API_KEY=

# GitHub personal access token — used by /restart and edit entry commands
GITHUB_TOKEN=
